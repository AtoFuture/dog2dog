      <link name='front_left_wheel_steering_link'>
        <pose>0.554283 0.5 0.02 0 0 0</pose>
        <inertial><mass>0.5</mass><inertia>
          <ixx>0.0153</ixx><iyy>0.025</iyy><izz>0.0153</izz></inertia></inertial>
