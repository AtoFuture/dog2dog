# Copy the variable names into your shell or a local .env file.
# Never commit a real API key.

# ---- G3 大脑（高层任务规划）----
MISSION_BRAIN_API_KEY=
MISSION_BRAIN_BASE_URL=https://api.deepseek.com
MISSION_BRAIN_MODEL=deepseek-flash
MISSION_BRAIN_TIMEOUT_S=15

# ---- VLM 视觉导航（DeepSeek-V4.1-Flash 图像理解）----
DEEPSEEK_API_KEY=
DEEPSEEK_VLM_BASE_URL=https://api.deepseek.com
DEEPSEEK_VLM_MODEL=deepseek-flash
