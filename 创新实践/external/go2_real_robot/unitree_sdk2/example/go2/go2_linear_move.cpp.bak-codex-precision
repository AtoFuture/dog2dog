/**********************************************************************
 GO2 linear movement control.
 Actions:
   forward/backward/left/right distance_m
   move_to_pos x_m y_m [yaw_deg]
***********************************************************************/

#include <algorithm>
#include <chrono>
#include <cmath>
#include <iostream>
#include <string>
#include <thread>

#include <unitree/idl/go2/SportModeState_.hpp>
#include <unitree/robot/channel/channel_subscriber.hpp>
#include <unitree/robot/go2/sport/sport_client.hpp>

#define TOPIC_HIGHSTATE "rt/sportmodestate"

using namespace unitree::robot;
using namespace unitree::robot::go2;

namespace
{

constexpr float kPi = 3.14159265358979323846f;

void PrintUsage(const char* program)
{
    std::cout << "Usage:\n"
              << "  " << program << " networkInterface forward|backward|left|right distance_m\n"
              << "  " << program << " networkInterface move_to_pos x_m y_m [yaw_deg]\n";
}

float NormalizeAngle(float angle)
{
    while (angle > kPi) {
        angle -= 2.0f * kPi;
    }
    while (angle < -kPi) {
        angle += 2.0f * kPi;
    }
    return angle;
}

class GO2LinearMove
{
public:
    GO2LinearMove()
    {
        sport_client.SetTimeout(10.0f);
        sport_client.Init();

        subscriber.reset(new ChannelSubscriber<unitree_go::msg::dds_::SportModeState_>(TOPIC_HIGHSTATE));
        subscriber->InitChannel(std::bind(&GO2LinearMove::StateHandler, this, std::placeholders::_1), 1);
    }

    ~GO2LinearMove()
    {
        subscriber.reset();
    }

    int MoveAxis(float body_x_m, float body_y_m)
    {
        WaitForState();
        PrintState("Initial");
        CallAndWait("BalanceStand", [&]() { return sport_client.BalanceStand(); }, 800);

        const float start_x = state.position()[0];
        const float start_y = state.position()[1];
        const float route_yaw = state.imu_state().rpy()[2];
        const float target_distance = std::hypot(body_x_m, body_y_m);
        const float body_dir_x = body_x_m / target_distance;
        const float body_dir_y = body_y_m / target_distance;
        const float world_dir_x = std::cos(route_yaw) * body_dir_x - std::sin(route_yaw) * body_dir_y;
        const float world_dir_y = std::sin(route_yaw) * body_dir_x + std::cos(route_yaw) * body_dir_y;

        std::cout << "linear_target:"
                  << " body_x=" << body_x_m
                  << " body_y=" << body_y_m
                  << " distance=" << target_distance
                  << " route_yaw=" << route_yaw
                  << std::endl;

        const int ret = MoveAlong(start_x, start_y, world_dir_x, world_dir_y, route_yaw, body_dir_x, body_dir_y, target_distance);
        PrintState("Final");
        return ret;
    }

    int MoveToPos(float target_x_m, float target_y_m, float target_yaw_deg)
    {
        WaitForState();
        PrintState("Initial");
        CallAndWait("BalanceStand", [&]() { return sport_client.BalanceStand(); }, 800);

        const float start_x = state.position()[0];
        const float start_y = state.position()[1];
        const float start_yaw = state.imu_state().rpy()[2];
        const float world_target_x = start_x + std::cos(start_yaw) * target_x_m - std::sin(start_yaw) * target_y_m;
        const float world_target_y = start_y + std::sin(start_yaw) * target_x_m + std::cos(start_yaw) * target_y_m;
        const float target_yaw = NormalizeAngle(start_yaw + target_yaw_deg * kPi / 180.0f);
        const float total_distance = std::hypot(target_x_m, target_y_m);
        const float max_time_sec = std::max(8.0f, total_distance / 0.30f + std::fabs(target_yaw_deg) / 30.0f + 8.0f);
        const int loop_ms = 20;

        std::cout << "move_to_pos_target:"
                  << " relative_x=" << target_x_m
                  << " relative_y=" << target_y_m
                  << " relative_yaw_deg=" << target_yaw_deg
                  << std::endl;

        int elapsed_ms = 0;
        int32_t last_ret = 0;
        while (elapsed_ms < static_cast<int>(max_time_sec * 1000)) {
            const float dx_world = world_target_x - state.position()[0];
            const float dy_world = world_target_y - state.position()[1];
            const float distance_error = std::hypot(dx_world, dy_world);
            const float yaw_error = NormalizeAngle(target_yaw - state.imu_state().rpy()[2]);
            if (distance_error < 0.06f && std::fabs(yaw_error) < 0.04f) {
                break;
            }

            const float yaw = state.imu_state().rpy()[2];
            const float body_x_error = std::cos(yaw) * dx_world + std::sin(yaw) * dy_world;
            const float body_y_error = -std::sin(yaw) * dx_world + std::cos(yaw) * dy_world;
            const float vx = std::clamp(0.7f * body_x_error, -0.45f, 0.45f);
            const float vy = std::clamp(0.7f * body_y_error, -0.35f, 0.35f);
            const float vyaw = std::clamp(0.9f * yaw_error, -0.45f, 0.45f);

            last_ret = sport_client.Move(vx, vy, vyaw);
            std::this_thread::sleep_for(std::chrono::milliseconds(loop_ms));
            elapsed_ms += loop_ms;

            if (elapsed_ms % 1000 == 0) {
                std::cout << "move_to_pos_progress:"
                          << " t=" << elapsed_ms / 1000.0f
                          << " distance_error=" << distance_error
                          << " yaw_error=" << yaw_error
                          << " vx=" << vx
                          << " vy=" << vy
                          << " vyaw=" << vyaw
                          << std::endl;
            }
        }

        std::cout << "Move ret:" << last_ret << std::endl;
        const int32_t stop_ret = sport_client.StopMove();
        std::cout << "StopMove ret:" << stop_ret << std::endl;
        std::this_thread::sleep_for(std::chrono::milliseconds(600));
        PrintState("Final");
        return stop_ret == 0 ? 0 : 1;
    }

private:
    void WaitForState()
    {
        std::this_thread::sleep_for(std::chrono::seconds(1));
    }

    template <typename Func>
    void CallAndWait(const std::string& name, Func func, int wait_ms)
    {
        std::cout << "action:" << name << std::endl;
        int32_t ret = func();
        std::cout << "ret:" << ret << (ret == 0 ? " ok" : " failed") << std::endl;
        std::this_thread::sleep_for(std::chrono::milliseconds(wait_ms));
    }

    int MoveAlong(float start_x, float start_y, float world_dir_x, float world_dir_y,
                  float target_yaw, float body_dir_x, float body_dir_y, float target_distance)
    {
        const float tolerance = std::max(0.04f, target_distance * 0.02f);
        const float max_time_sec = std::max(8.0f, target_distance / 0.35f + 8.0f);
        const int loop_ms = 20;
        const float yaw_kp = 0.9f;
        int elapsed_ms = 0;
        int32_t last_ret = 0;
        float progress = 0.0f;

        while (elapsed_ms < static_cast<int>(max_time_sec * 1000)) {
            const float dx = state.position()[0] - start_x;
            const float dy = state.position()[1] - start_y;
            progress = dx * world_dir_x + dy * world_dir_y;
            const float remaining = target_distance - progress;
            if (remaining <= tolerance) {
                break;
            }

            const float speed = remaining > 0.30f ? 0.40f : 0.16f;
            const float yaw_error = NormalizeAngle(target_yaw - state.imu_state().rpy()[2]);
            const float vyaw = std::clamp(yaw_kp * yaw_error, -0.35f, 0.35f);
            last_ret = sport_client.Move(body_dir_x * speed, body_dir_y * speed, vyaw);
            std::this_thread::sleep_for(std::chrono::milliseconds(loop_ms));
            elapsed_ms += loop_ms;

            if (elapsed_ms % 1000 == 0) {
                std::cout << "linear_progress:"
                          << " t=" << elapsed_ms / 1000.0f
                          << " progress=" << progress
                          << " remaining=" << std::max(0.0f, remaining)
                          << " vx=" << body_dir_x * speed
                          << " vy=" << body_dir_y * speed
                          << " vyaw=" << vyaw
                          << std::endl;
            }
        }

        std::cout << "Move ret:" << last_ret << std::endl;
        const int32_t stop_ret = sport_client.StopMove();
        std::cout << "StopMove ret:" << stop_ret << std::endl;
        std::this_thread::sleep_for(std::chrono::milliseconds(600));
        const float final_error = target_distance - progress;
        std::cout << "final_progress:" << progress << std::endl;
        std::cout << "final_error:" << final_error << std::endl;
        return stop_ret == 0 ? 0 : 1;
    }

    void PrintState(const std::string& title)
    {
        std::cout << title << ":"
                  << " x=" << state.position()[0]
                  << " y=" << state.position()[1]
                  << " z=" << state.position()[2]
                  << " roll=" << state.imu_state().rpy()[0]
                  << " pitch=" << state.imu_state().rpy()[1]
                  << " yaw=" << state.imu_state().rpy()[2]
                  << std::endl;
    }

    void StateHandler(const void* message)
    {
        state = *(unitree_go::msg::dds_::SportModeState_*)message;
    }

    unitree_go::msg::dds_::SportModeState_ state;
    SportClient sport_client;
    ChannelSubscriberPtr<unitree_go::msg::dds_::SportModeState_> subscriber;
};

}  // namespace

int main(int argc, char** argv)
{
    if (argc < 4) {
        PrintUsage(argv[0]);
        return 2;
    }

    const std::string network_interface = argv[1];
    const std::string action = argv[2];
    ChannelFactory::Instance()->Init(0, network_interface);
    GO2LinearMove move;

    if (action == "move_to_pos") {
        if (argc < 5 || argc > 6) {
            PrintUsage(argv[0]);
            return 2;
        }
        const float x = std::clamp(std::stof(argv[3]), -10.0f, 10.0f);
        const float y = std::clamp(std::stof(argv[4]), -10.0f, 10.0f);
        const float yaw = argc >= 6 ? std::clamp(std::stof(argv[5]), -180.0f, 180.0f) : 0.0f;
        return move.MoveToPos(x, y, yaw);
    }

    const float distance = std::clamp(std::stof(argv[3]), 0.03f, 10.0f);
    if (action == "forward") {
        return move.MoveAxis(distance, 0.0f);
    }
    if (action == "backward" || action == "back") {
        return move.MoveAxis(-distance, 0.0f);
    }
    if (action == "left") {
        return move.MoveAxis(0.0f, distance);
    }
    if (action == "right") {
        return move.MoveAxis(0.0f, -distance);
    }

    PrintUsage(argv[0]);
    return 2;
}
