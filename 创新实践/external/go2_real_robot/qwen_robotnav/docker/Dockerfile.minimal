# Minimal Qwen-RobotNav validation container (no ROS2, no Unitree SDK).
# Uses Ubuntu 24.04 and mounts host JetPack 7.2 libraries at runtime.
ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV WORKSPACE=/workspace/qwen_robotnav

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    wget \
    curl \
    ca-certificates \
    python3-pip \
    python3-dev \
    python3-venv \
    libopencv-dev \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    vim \
    nano \
    && rm -rf /var/lib/apt/lists/*

# Use system pip/setuptools/wheel; only install application packages below.

# Only install packages required by the local navigation pipeline.
# The heavy VLM inference runs on the remote vLLM server.
RUN python3 -m pip install --break-system-packages --no-cache-dir \
    -i https://pypi.tuna.tsinghua.edu.cn/simple \
    openai>=1.0.0 \
    opencv-python \
    numpy \
    scipy \
    pillow \
    pyyaml \
    pytest \
    pytest-asyncio

WORKDIR ${WORKSPACE}
COPY qwen_robotnav ./qwen_robotnav
COPY tests ./tests
COPY scripts ./scripts

# No pip install needed; PYTHONPATH is sufficient for the source tree.
ENV PYTHONPATH="${WORKSPACE}:${WORKSPACE}/qwen_robotnav:${PYTHONPATH}"
CMD ["/bin/bash"]
