/**********************************************************************
 GO2 yaw turn control.
 Actions:
   left/right angle_deg
***********************************************************************/

#include <algorithm>
#include <chrono>
#include <cmath>
#include <iostream>
#include <string>
#include <thread>

#include <unitree/idl/go2/SportModeState_.hpp>
#include <unitree/robot/channel/channel_subscriber.hpp>
#include <unitree/robot/go2/sport/sport_client.hpp>

#define TOPIC_HIGHSTATE "rt/sportmodestate"

using namespace unitree::robot;
using namespace unitree::robot::go2;

namespace
{

constexpr float kPi = 3.14159265358979323846f;

void PrintUsage(const char* program)
{
    std::cout << "Usage: " << program << " networkInterface left|right angle_deg\n";
}

float NormalizeAngle(float angle)
{
    while (angle > kPi) {
        angle -= 2.0f * kPi;
    }
    while (angle < -kPi) {
        angle += 2.0f * kPi;
    }
    return angle;
}

class GO2Turn
{
public:
    GO2Turn()
    {
        sport_client.SetTimeout(10.0f);
        sport_client.Init();

        subscriber.reset(new ChannelSubscriber<unitree_go::msg::dds_::SportModeState_>(TOPIC_HIGHSTATE));
        subscriber->InitChannel(std::bind(&GO2Turn::StateHandler, this, std::placeholders::_1), 1);
    }

    ~GO2Turn()
    {
        subscriber.reset();
    }

    int Run(float signed_degrees)
    {
        std::this_thread::sleep_for(std::chrono::seconds(1));
        PrintState("Initial");
        CallAndWait("BalanceStand", [&]() { return sport_client.BalanceStand(); }, 800);
        const int ret = TurnDegrees(signed_degrees);
        PrintState("Final");
        return ret;
    }

private:
    template <typename Func>
    void CallAndWait(const std::string& name, Func func, int wait_ms)
    {
        std::cout << "action:" << name << std::endl;
        int32_t ret = func();
        std::cout << "ret:" << ret << (ret == 0 ? " ok" : " failed") << std::endl;
        std::this_thread::sleep_for(std::chrono::milliseconds(wait_ms));
    }

    int TurnDegrees(float signed_degrees)
    {
        const float start_yaw = state.imu_state().rpy()[2];
        const float target_yaw = NormalizeAngle(start_yaw + signed_degrees * kPi / 180.0f);
        const float tolerance = 0.035f;
        const int loop_ms = 20;
        const int max_time_ms = static_cast<int>(std::max(5000.0f, std::fabs(signed_degrees) / 30.0f * 1000.0f + 5000.0f));

        std::cout << "turn_target:"
                  << " direction=" << (signed_degrees >= 0.0f ? "left" : "right")
                  << " degrees=" << std::fabs(signed_degrees)
                  << " start_yaw=" << start_yaw
                  << " target_yaw=" << target_yaw
                  << std::endl;

        int elapsed_ms = 0;
        int32_t last_ret = 0;
        float yaw_error = NormalizeAngle(target_yaw - state.imu_state().rpy()[2]);
        while (elapsed_ms < max_time_ms) {
            yaw_error = NormalizeAngle(target_yaw - state.imu_state().rpy()[2]);
            if (std::fabs(yaw_error) <= tolerance) {
                break;
            }

            const float abs_error = std::fabs(yaw_error);
            const float turn_speed = abs_error > 0.30f ? 0.55f : 0.22f;
            const float vyaw = std::copysign(turn_speed, yaw_error);
            last_ret = sport_client.Move(0.0f, 0.0f, vyaw);
            std::this_thread::sleep_for(std::chrono::milliseconds(loop_ms));
            elapsed_ms += loop_ms;

            if (elapsed_ms % 500 == 0) {
                std::cout << "turn_progress:"
                          << " t=" << elapsed_ms / 1000.0f
                          << " yaw_error=" << yaw_error
                          << " vyaw=" << vyaw
                          << std::endl;
            }
        }

        std::cout << "Move ret:" << last_ret << std::endl;
        const int32_t stop_ret = sport_client.StopMove();
        std::cout << "StopMove ret:" << stop_ret << std::endl;
        std::this_thread::sleep_for(std::chrono::milliseconds(600));

        const float final_yaw = state.imu_state().rpy()[2];
        const float final_error = NormalizeAngle(target_yaw - final_yaw);
        std::cout << "final_yaw:" << final_yaw << std::endl;
        std::cout << "final_error_rad:" << final_error << std::endl;
        std::cout << "final_error_deg:" << final_error * 180.0f / kPi << std::endl;
        return stop_ret == 0 ? 0 : 1;
    }

    void PrintState(const std::string& title)
    {
        std::cout << title << ":"
                  << " roll=" << state.imu_state().rpy()[0]
                  << " pitch=" << state.imu_state().rpy()[1]
                  << " yaw=" << state.imu_state().rpy()[2]
                  << std::endl;
    }

    void StateHandler(const void* message)
    {
        state = *(unitree_go::msg::dds_::SportModeState_*)message;
    }

    unitree_go::msg::dds_::SportModeState_ state;
    SportClient sport_client;
    ChannelSubscriberPtr<unitree_go::msg::dds_::SportModeState_> subscriber;
};

}  // namespace

int main(int argc, char** argv)
{
    if (argc < 4) {
        PrintUsage(argv[0]);
        return 2;
    }

    const std::string network_interface = argv[1];
    const std::string direction = argv[2];
    const float angle = std::clamp(std::stof(argv[3]), 1.0f, 180.0f);
    const float signed_degrees = (direction == "right") ? -angle : angle;

    ChannelFactory::Instance()->Init(0, network_interface);
    GO2Turn turn;
    return turn.Run(signed_degrees);
}
